# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Runtime state: the server's database and the model it scores with ──────────
# Both are regenerated by provisioning (`python -m server.keygen`, then
# `python -m server.ml.train`), so neither belongs in the repository. The database
# additionally holds real user names, hostnames, and file paths from monitored
# endpoints — committing it would publish the very telemetry the system collects.
data/
models/*.pkl

# ── Key material — never commit, on any machine ────────────────────────────────
# ML-DSA secret keys (endpoint identity) and the server's ML-KEM decapsulation
# key. A leaked server KEM secret lets an attacker decrypt every recorded batch;
# a leaked agent secret lets them impersonate that endpoint. Regenerate with
# `python -m server.keygen` / `python -m agent.keygen`.
keys/
*.key
*.pem

# ── Local configuration (contains LAN addresses and enrollment tokens) ────────
# Commit the *.example.yaml files instead; those are checked in.
agent_config.yaml
server_config.yaml

# ── Demo and test workspaces ──────────────────────────────────────────────────
demo/
.vigil-demo/

# ── React dashboard build output ───────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── CERT r4.2 dataset (optional training source — 13+ GB, too large for git) ───
# Only needed for `python -m server.ml.train --source cert`. The default
# `--source synthetic` needs no download at all.
data/cert_r4.2/
#   data/cert_r4.2/logon.csv
#   data/cert_r4.2/device.csv
#   data/cert_r4.2/file.csv
#   data/cert_r4.2/http.csv      (13.8 GB)
#   data/cert_r4.2/email.csv

# ── Legacy batch-mode outputs (see legacy/) ───────────────────────────────────
data/alerts.jsonl
data/logs.csv
data/test_results.csv
data/test_scenarios/
data/r4.2-1/

# ── IDE, tooling & OS ─────────────────────────────────────────────────────────
.claude/
.vscode/
.idea/
*.DS_Store
Thumbs.db
